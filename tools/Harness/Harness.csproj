<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>TapaBuraco.Harness</AssemblyName>
    <RootNamespace>TapaBuraco.Harness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- O shim reimplementa tipos da Unity: avisos de campo não usado/obsoleto só fazem ruído. -->
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0067;CS0660;CS0661;CS0169</NoWarn>
  </PropertyGroup>

  <!--
    Compila o jogo de verdade (núcleo + apresentação) contra um shim de UnityEngine.
    O shim mora AQUI e nunca dentro de unity/Assets, senão o editor tentaria compilá-lo
    junto com a UnityEngine real e daria conflito de tipos duplicados.
  -->
  <ItemGroup>
    <Compile Include="../../unity/Assets/Scripts/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../unity/Assets/Scripts/Game/**/*.cs" LinkBase="Game" />
    <Compile Include="Shim/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
