<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>TapaBuraco.CoreTests</AssemblyName>
    <RootNamespace>TapaBuraco.CoreTests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Compila o núcleo do projeto Unity (C# puro, sem UnityEngine) fora do editor. -->
  <ItemGroup>
    <Compile Include="../../unity/Assets/Scripts/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
